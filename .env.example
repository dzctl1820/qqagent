DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ===== QQ 官方机器人配置 =====
# 在 https://q.qq.com 注册后获取
QQ_BOTS='
[
  {
    "id": "你的AppID",
    "token": "",
    "secret": "你的AppSecret",
    "intent": {
      "c2c_group_at_messages": true,
      "at_messages": true
    },
    "use_websocket": true
  }
]
'

# ===== AI 对话配置 =====
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=deepseek-chat
AI_SYSTEM_PROMPT=你是一个友好的QQ群聊AI助手，回答简洁有趣。
AI_TRIGGER_PREFIX=/ai
AI_CONTEXT_ROUNDS=5

# ===== 群管理配置 =====
GROUP_WELCOME=欢迎加入本群！请阅读群公告~
GROUP_KEYWORDS={"你好":"你好呀~","早安":"早上好！元气满满的一天~","晚安":"晚安，好梦~"}

# ===== 定时任务配置 =====
SCHEDULER_JOBS=[]
