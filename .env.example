DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ===== AI 对话配置 =====
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=你是一个友好的QQ群聊AI助手，回答简洁有趣。
AI_TRIGGER_PREFIX=/ai
AI_CONTEXT_ROUNDS=5

# ===== 群管理配置 =====
GROUP_WELCOME=欢迎加入本群！请阅读群公告~
GROUP_KEYWORDS={"你好":"你好呀~","早安":"早上好！元气满满的一天~","晚安":"晚安，好梦~"}

# ===== 定时任务配置 =====
SCHEDULER_JOBS=[{"group_id":123456789,"hour":8,"minute":0,"message":"早上好！新的一天开始了~"},{"group_id":123456789,"hour":22,"minute":0,"message":"夜深了，大家早点休息~"}]
