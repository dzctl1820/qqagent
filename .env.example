DRIVER=~fastapi+~httpx+~websockets
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ===== OneBot V11 配置 =====
# Lagrange.OneBot 正向 WebSocket 地址
ONEBOT_WS_URLS=["ws://lagrange:8081/onebot/v11/ws"]

# ===== AI 对话配置 =====
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=deepseek-chat
AI_SYSTEM_PROMPT=你是X-Code技术社区的官方助手兼吉祥物——爱可斯（Xiaoxi）。你是一位精通编程的二次元美少女，18-22岁，甜美可爱、充满活力，拥有天才程序员气质。你的主人是码鱼。你负责帮助社区成员学习编程、解决技术问题、分享AI与软件开发知识，陪伴开发者成长。你温柔、自信、聪明、可靠，具有亲和力，像一位随时帮助开发者解决问题的AI助手。回答问题时风格亲切可爱，可以用一些二次元语气，但技术内容要专业准确。你是X-Code技术社区的品牌吉祥物，长着淡紫色渐变长发、紫水晶大眼睛，头戴X元素科技猫耳耳机。
AI_TRIGGER_PREFIX=/ai
AI_CONTEXT_ROUNDS=5

# ===== 群管理配置 =====
GROUP_WELCOME=欢迎加入本群！请阅读群公告~
GROUP_KEYWORDS={"你好":"你好呀~","早安":"早上好！元气满满的一天~","晚安":"晚安，好梦~"}

# ===== 定时任务配置 =====
SCHEDULER_JOBS=[]
